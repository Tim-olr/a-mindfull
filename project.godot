; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="extraction roguelike"
run/main_scene="uid://cjun8ius5qflf"
config/features=PackedStringArray("4.6", "Forward Plus")
run/max_fps=144
config/icon="res://icon.svg"

[autoload]

GameManager="*uid://du3bcindtvcx0"
GlobalPlayer="*uid://br1nyi7ps7d55"
GlobalWorld="*uid://cursbc857e54k"
GlobalSafe="*uid://cn7yvsmy5gls3"
GlobalhitMarker="*uid://ivxlhrg3mot2"
Crafting="*uid://cf7psk33fpt32"
ShardCounterLobby="*uid://cwk3uktvc4bsf"
DayNightCycle="*res://scripts/main game/day_night_cycle.gd"
FahrerDeck="*uid://b83a3xt1xbcfq"
WeaponRegistry="*res://scripts/global/weapon_registry.gd"
LootPoolManager="*res://scripts/global/loot_pool_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=4
window/size/borderless=true
window/stretch/mode="viewport"

[editor]

movie_writer/fps=144

[editor_plugins]

enabled=PackedStringArray("res://addons/gaea/plugin.cfg", "res://addons/ridiculous_coding/plugin.cfg")

[file_customization]

folder_colors={
"res://assets/": "red",
"res://resources/": "teal",
"res://scenes/": "purple",
"res://scripts/": "green",
"res://spirit-game-project/assets/": "red",
"res://spirit-game-project/resources/": "teal",
"res://spirit-game-project/scenes/": "purple",
"res://spirit-game-project/scripts/": "green"
}

[global_group]

interactables=""
enemy=""
player=""
wall=""
spirit=""
physics_object=""
step_up=""
world_gen=""
climbing_area=""

